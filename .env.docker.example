# Copy to .env.docker and fill in. Never commit the real .env.docker file.

# Required: a stable session-signing key. Without this, the key regenerates
# on every container restart and every logged-in session drops (see
# webapp/app.py's _resolve_secret_key). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
WEBAPP_SECRET_KEY=

# Login credentials for this single-user demo app.
WEBAPP_USERNAME=admin
WEBAPP_PASSWORD=changeme

AWS_REGION=us-east-1

# Optional: enables the LLM content-analysis dimension. Tried in order --
# direct Anthropic API, then OpenRouter, then Amazon Bedrock (if enabled
# below) -- the first one with a key/config wins. Leave all blank to run
# without this dimension entirely; the pipeline degrades gracefully.
ANTHROPIC_API_KEY=

# For setups with only a shared/hackathon OpenRouter key instead of a
# direct Anthropic account. READINESS_OPENROUTER_MODEL defaults to
# anthropic.claude-sonnet-5 if not set. If your key is for a custom
# gateway rather than the public openrouter.ai API, also set
# OPENROUTER_BASE_URL to that gateway's chat-completions endpoint.
OPENROUTER_API_KEY=
# READINESS_OPENROUTER_MODEL=anthropic.claude-sonnet-5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Only needed if you're NOT mounting ~/.aws (see docker-compose.yml) and
# want to pass static AWS credentials directly instead. Leave blank if
# you're using the ~/.aws mount / an assumed SSO role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
